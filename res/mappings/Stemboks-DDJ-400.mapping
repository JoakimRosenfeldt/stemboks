input "deck-2-eq-low-midi-cc-1-15" "deck.2.eq.low" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 1 15 0 0 0
input "deck-2-colorFx-amount-midi-cc-6-24" "deck.2.colorfx.amount" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 6 24 0 0 0
input "deck-2-level-volume-midi-cc-1-19" "deck.2.level.volume" write absolute linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 1 19 0 0 0
input "deck-2-level-pfl-midi-note-1-84" "deck.2.level.pfl" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 1 84 0 0 0
output "lamp-deck.2.level.pfl" "deck.2.level.pfl" midi none scale 0 1 0 3 literal 145 literal 84 value7 0
