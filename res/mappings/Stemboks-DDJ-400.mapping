# Custom layer: SHIFT + PLAY toggles quantize on the unshifted play message.
input "deck-2-grid-quantize-midi-note-1-11-deck-2-shift" "deck.2.grid.quantize" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 1 11 0 0 0 modifier "deck-2-shift"
input "deck-2-tempo-fader-midi-cc-1-0" "deck.2.tempo.fader" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 1 0 0 0 0
input "deck-2-scratch-wheelMove-midi-cc-1-33" "deck.2.jog.move" write relative linear 1 0 127 0 0.05 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 1 33 0 0 0
input "deck-2-scratch-wheelMove-midi-cc-1-34" "deck.2.jog.move" write relative linear 1 0 127 0 0.05 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 1 34 0 0 0
input "deck-2-scratch-wheelTouch-midi-note-1-54" "deck.2.jog.touch" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 1 54 0 0 0
input "deck-2-level-gain-midi-cc-1-4" "deck.2.level.gain" write absolute linear 1 0 127 0 4 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 1 4 0 0 0
