# Browse, crossfader, monitoring and beat effects.
input "mixer-crossfader-position-midi-cc-6-31" "mixer.crossfader.position" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 6 31 0 0 0
input "mixer-head-mix-midi-cc-6-12" "mixer.head.mix" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 6 12 0 0 0
input "mixer-head-gain-midi-cc-6-13" "mixer.head.gain" write absolute linear 1 0 127 0 5 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 6 13 0 0 0
input "fx-unit-1-mix-midi-cc-4-2" "fx.unit.1.mix" write absolute linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 4 2 0 0 0
input "fx-unit-1-slot-1-enabled-midi-note-4-71" "fx.unit.1.enabled" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 4 71 0 0 0
output "lamp-fx.unit.1.slot.1.enabled" "fx.unit.1.enabled" midi none scale 0 1 0 3 literal 148 literal 71 value7 0
input "fx-unit-1-slot-1-timePrevious-midi-note-4-74" "fx.unit.1.parameter" write relative linear 1 0 127 0 -0.05 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 4 74 0 0 0
input "fx-unit-1-slot-1-timeNext-midi-note-4-75" "fx.unit.1.parameter" write relative linear 1 0 127 0 0.05 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 4 75 0 0 0
