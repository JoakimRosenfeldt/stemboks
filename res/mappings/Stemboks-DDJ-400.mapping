input "deck-2-hotcue-1-midi-note-9-0" "deck.2.pads.cell.1.press" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 9 0 0 0 0
input "deck-2-hotcue-2-midi-note-9-1" "deck.2.pads.cell.2.press" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 9 1 0 0 0
input "deck-2-hotcue-3-midi-note-9-2" "deck.2.pads.cell.3.press" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 9 2 0 0 0
input "deck-2-hotcue-4-midi-note-9-3" "deck.2.pads.cell.4.press" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 9 3 0 0 0
