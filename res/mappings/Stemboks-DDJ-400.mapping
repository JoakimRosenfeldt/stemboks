input "fx-unit-1-assign-deck-2-midi-note-4-17" "deck.2.fx.unit1" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 4 17 0 0 0

# Pad-mode buttons use the reference preset MIDI assignments; values follow the app pages.
