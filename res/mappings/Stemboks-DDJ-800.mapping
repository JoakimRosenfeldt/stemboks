SBX_CONTROLLER_MAPPING 6
id "stemboks-DDJ-800"
name "Stemboks Pioneer DDJ-800"
device midi 0 0 "DDJ-800"
# Hardware note/CC addresses were read from the installed reference presets.
# Tempo uses the documented CC MSB. No undocumented pitch-bend message is assumed.
# Hotcue-page pads use the CH-03 pad-cell press controls.

# Deck 1: transport, mixer and performance pads.
modifier "layer-1" "deck-1-shift" held 0 midi midi-note 0 63 0 0 0
input "deck-1-transport-playing-midi-note-0-11" "deck.1.transport.playing" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 11 0 0 0
output "lamp-deck.1.transport.playing" "deck.1.transport.playing" midi none scale 0 1 0 3 literal 144 literal 11 value7 0
input "deck-1-cue-button-midi-note-0-12" "deck.1.transport.cue" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 12 0 0 0
input "deck-1-sync-enabled-midi-note-0-88" "deck.1.sync.enabled" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 88 0 0 0
output "lamp-deck.1.sync.enabled" "deck.1.sync.enabled" midi none scale 0 1 0 3 literal 144 literal 88 value7 0
input "deck-1-tempo-keyLock-midi-note-0-26" "deck.1.key.lock" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 26 0 0 0
input "deck-1-grid-quantize-midi-note-0-53" "deck.1.grid.quantize" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 53 0 0 0
input "deck-1-tempo-fader-midi-cc-0-0" "deck.1.tempo.fader" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 0 0 0 0
input "deck-1-scratch-wheelMove-midi-cc-0-33" "deck.1.jog.move" write relative linear 1 0 127 0 0.05 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 33 0 0 0
input "deck-1-scratch-wheelMove-midi-cc-0-34" "deck.1.jog.move" write relative linear 1 0 127 0 0.05 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 34 0 0 0
input "deck-1-scratch-wheelMove-midi-cc-0-35" "deck.1.jog.move" write relative linear 1 0 127 0 0.05 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 35 0 0 0
input "deck-1-scratch-wheelTouch-midi-note-0-54" "deck.1.jog.touch" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 54 0 0 0
input "deck-1-level-gain-midi-cc-0-4" "deck.1.level.gain" write absolute linear 1 0 127 0 4 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 4 0 0 0
input "deck-1-eq-high-midi-cc-0-7" "deck.1.eq.high" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 7 0 0 0
input "deck-1-eq-mid-midi-cc-0-11" "deck.1.eq.mid" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 11 0 0 0
input "deck-1-eq-low-midi-cc-0-15" "deck.1.eq.low" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 15 0 0 0
input "deck-1-colorFx-amount-midi-cc-6-23" "deck.1.colorfx.amount" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 6 23 0 0 0
input "deck-1-level-volume-midi-cc-0-19" "deck.1.level.volume" write absolute linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 0 19 0 0 0
input "deck-1-level-pfl-midi-note-0-84" "deck.1.level.pfl" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 84 0 0 0
output "lamp-deck.1.level.pfl" "deck.1.level.pfl" midi none scale 0 1 0 3 literal 144 literal 84 value7 0
input "deck-1-loop-setIn-midi-note-0-16" "deck.1.loop.setIn" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 16 0 0 0
input "deck-1-loop-setOut-midi-note-0-17-!deck-1-shift" "deck.1.loop.setOut" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 17 0 0 0 modifier "!deck-1-shift"
input "deck-1-loop-fourBeatExit-midi-note-0-77-!deck-1-shift" "deck.1.loop.active" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 77 0 0 0 modifier "!deck-1-shift"
# Custom loop layer: SHIFT + OUT = RELOOP; SHIFT + LOOP EXIT = ACTIVE LOOP.
input "deck-1-loop-reloop-midi-note-0-17-deck-1-shift" "deck.1.loop.enabled" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 0 17 0 0 0 modifier "deck-1-shift"
