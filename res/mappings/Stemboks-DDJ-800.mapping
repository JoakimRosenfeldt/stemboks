input "deck-4-eq-low-midi-cc-3-15" "deck.4.eq.low" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 3 15 0 0 0
input "deck-4-colorFx-amount-midi-cc-6-26" "deck.4.colorfx.amount" write absolute linear 1 0 127 -1 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 6 26 0 0 0
input "deck-4-level-volume-midi-cc-3-19" "deck.4.level.volume" write absolute linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-cc 3 19 0 0 0
input "deck-4-level-pfl-midi-note-3-84" "deck.4.level.pfl" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 3 84 0 0 0
output "lamp-deck.4.level.pfl" "deck.4.level.pfl" midi none scale 0 1 0 3 literal 147 literal 84 value7 0
input "deck-4-loop-setIn-midi-note-3-16" "deck.4.loop.setIn" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 3 16 0 0 0
input "deck-4-loop-setOut-midi-note-3-17-!deck-4-shift" "deck.4.loop.setOut" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 3 17 0 0 0 modifier "!deck-4-shift"
input "deck-4-loop-fourBeatExit-midi-note-3-77-!deck-4-shift" "deck.4.loop.active" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 3 77 0 0 0 modifier "!deck-4-shift"
# Custom loop layer: SHIFT + OUT = RELOOP; SHIFT + LOOP EXIT = ACTIVE LOOP.
input "deck-4-loop-reloop-midi-note-3-17-deck-4-shift" "deck.4.loop.enabled" write toggle linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 3 17 0 0 0 modifier "deck-4-shift"
input "deck-4-loop-activeLoop-midi-note-3-77-deck-4-shift" "deck.4.loop.active" write momentary linear 1 0 127 0 1 1 0 0 0.5 0.05 0 0 0.02 0 0 midi midi-note 3 77 0 0 0 modifier "deck-4-shift"
